# This file is intentionally safe to commit. Copy it to .env.live-test and fill
# only with accounts, contacts, and groups dedicated to destructive testing.
MIAW_RUN_LIVE_TESTS=true
MIAW_LIVE_AUTH=qr
MIAW_LIVE_INSTANCE_ID=live-integration-bot
MIAW_LIVE_PHONE=6280000000000
MIAW_LIVE_CONTACT_A=6280000000001
MIAW_LIVE_CONTACT_B=6280000000002
MIAW_LIVE_CONFIRM_DESTRUCTIVE=true

# Optional existing isolated fixtures. Leave blank to skip their probe.
MIAW_LIVE_GROUP_JID=
MIAW_LIVE_COMMUNITY_JID=
