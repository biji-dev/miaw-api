# Server Configuration
PORT=3000
HOST=0.0.0.0

# API Key (single key for all requests)
API_KEY=your-secret-api-key-here

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000

# CORS
CORS_ORIGIN=*

# Session Storage
SESSION_PATH=./sessions

# Optional Proxy Pool
# Mount this file as a secret. Supported formats: TXT, JSON.
# MIAW_PROXY_FILE=/run/secrets/miaw-proxies.txt
MIAW_PROXY_STRATEGY=deterministic

# Persistent instance + proxy store. Shared with `miaw-cli instance set-proxy`.
# Defaults to $SESSION_PATH/instances.json. Keep it on the same persistent
# volume as the sessions: losing it silently changes a paired session's egress.
# INSTANCE_STORE_FILE=./sessions/instances.json
# Connect restored instances at boot, sequentially. Off by default.
RESTORE_AUTOCONNECT=false

# Logging
LOG_LEVEL=info
